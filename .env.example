# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne jamais committer le fichier ".env" (voir .gitignore) - Principe 11.

# --- Application ---
APP_ENV=development
SECRET_KEY=changeme-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de données ---
DATABASE_URL=sqlite:///./ai_commerce_builder.db

# --- Admin (utilisateur unique du MVP) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- IA (Claude) ---
ANTHROPIC_API_KEY=

# --- Payment Engine ---
# Liste des providers actifs, separes par des virgules.
PAYMENT_PROVIDER_ACTIVE=yas_tmoney,moov_money,card
# Mode simulation : true tant qu'aucun compte marchand n'est valide.
PAYMENT_SIMULATE=true

# --- CinetPay (desactive au J0, pret a brancher) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_ENABLED=false
